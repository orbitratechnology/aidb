{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions for the main application window. Grant only what the UI calls.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-diagnostics",
    "allow-open-external-url",
    "allow-get-settings",
    "allow-update-settings",
    "allow-storage-summary",
    "allow-clear-local-data",
    "allow-list-connections",
    "allow-create-connection",
    "allow-update-connection",
    "allow-delete-connection",
    "allow-save-connection-password",
    "allow-forget-connection-password",
    "allow-parse-connection-uri",
    "allow-export-connections",
    "allow-preview-connection-import",
    "allow-import-connections",
    "allow-test-connection",
    "allow-connect",
    "allow-disconnect",
    "allow-active-sessions",
    "allow-catalog-overview",
    "allow-refresh-catalog",
    "allow-describe-object",
    "allow-open-schema-file",
    "allow-close-schema-file",
    "allow-compare-schemas",
    "allow-save-schema-script",
    "allow-prepare-migration",
    "allow-apply-migration",
    "allow-cancel-migration",
    "allow-list-migration-records",
    "allow-read-table-page",
    "allow-cancel-operation",
    "allow-export-table",
    "allow-analyze-sql",
    "allow-run-query",
    "allow-list-query-history",
    "allow-delete-query-history-entry",
    "allow-list-saved-queries",
    "allow-save-query",
    "allow-delete-saved-query",
    "allow-list-providers",
    "allow-create-provider",
    "allow-update-provider",
    "allow-delete-provider",
    "allow-save-provider-key",
    "allow-forget-provider-key",
    "allow-test-provider",
    "allow-preview-assistant-context",
    "allow-ask-assistant",
    "allow-cancel-assistant-task",
    "allow-list-audit-events",
    "allow-preview-data-change",
    "allow-apply-data-change",
    "allow-cancel-data-change",
    "allow-list-pending-changes",
    "allow-open-csv-import",
    "allow-reread-csv-import",
    "allow-preview-csv-import",
    "allow-close-csv-import"
