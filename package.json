{
  "name": "aidb",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first desktop database client with an optional natural-language agent",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "dev:web": "pnpm --filter @aidb/desktop dev",
    "build:web": "pnpm --filter @aidb/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
