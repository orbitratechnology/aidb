{
  "description": "After one prepared change, a second is turned away with a message, so the user reviews one decision at a time.",
  "question": "Cancel orders 3 and 6.",
  "writable": true,
  "model": [
    {
      "calls": [
        {
          "name": "preview_data_change",
          "input": {
            "purpose": "Cancel order 3",
            "changes": [
              {
                "kind": "update",
                "schema": "public",
                "table": "orders",
                "set": [{ "column": "status", "value": "cancelled" }],
                "filters": [{ "column": "id", "operator": "equals", "value": "3" }]
              }
            ]
          }
        }
      ]
    },
    {
      "calls": [
        {
          "name": "preview_data_change",
          "input": {
            "purpose": "Cancel order 6",
            "changes": [
              {
                "kind": "update",
                "schema": "public",
                "table": "orders",
                "set": [{ "column": "status", "value": "cancelled" }],
                "filters": [{ "column": "id", "operator": "equals", "value": "6" }]
              }
            ]
          }
        }
      ]
    },
    { "text": "Order 3 is waiting for your review; I can prepare order 6 after." }
  ],
  "expect": {
    "status": "succeeded",
    "steps": [["preview_data_change", "succeeded"]],
    "results_contain": ["already prepared a change"],
    "proposal": true
  }
}
