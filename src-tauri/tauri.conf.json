{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "aidb",
  "version": "0.1.0",
  "identifier": "com.orbitratech.aidb",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aidb",
        "width": 1280,
        "height": 800,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true,
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "isolation"
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first PostgreSQL client with an optional AI agent",
    "copyright": "Copyright (c) 2026 Orbitra Tech",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
