{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions for the main application window. Grant only what the UI calls.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-diagnostics",
    "allow-open-external-url",
    "allow-get-settings",
    "allow-update-settings",
    "allow-storage-summary",
    "allow-clear-local-data"
  ]
}
