{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions for the main application window. Grant only what the UI calls.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-diagnostics",
    "allow-open-external-url",
    "allow-get-settings",
    "allow-update-settings",
    "allow-storage-summary",
    "allow-clear-local-data",
    "allow-list-connections",
    "allow-create-connection",
    "allow-update-connection",
    "allow-delete-connection",
    "allow-save-connection-password",
    "allow-forget-connection-password",
    "allow-parse-connection-uri",
    "allow-export-connections",
    "allow-preview-connection-import",
    "allow-import-connections"
  ]
}
